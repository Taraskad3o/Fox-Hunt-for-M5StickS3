void drawHunterUI() {
    canvas.fillScreen(BLACK);

    canvas.setTextSize(2);
    if (isLinkAlive) {
        if (lastRssi > RSSI_DANGER_THRESHOLD) {
            canvas.setTextColor(RED);
            canvas.drawCenterString("TARGET NEAR", 67, 5);
        } else {
            canvas.setTextColor(GREEN);
            canvas.drawCenterString("TRACKING", 67, 5);
        }
    } else {
        canvas.setTextColor(canvas.color565(100, 100, 100));
        canvas.drawCenterString("SIGNAL LOST", 67, 5);
    }

    drawBattery();

    int numBars = isLinkAlive ? constrain(map(lastRssi, -90, -45, 1, 12), 0, 12) : 0;
    int boxX = 55, boxY = 30, boxW = 24, boxH = 130;
    canvas.drawRoundRect(boxX, boxY, boxW, boxH, 4, canvas.color565(60, 60, 60));
    
    for (int i = 0; i < 12; i++) {
        int segH = 8;
        int segW = 18;
        int segX = boxX + 3;
        int segY = (boxY + boxH - 10) - (i * 10);

        uint16_t bColor = canvas.color565(25, 25, 25);
        if (isLinkAlive && i < numBars) {
            bColor = (i < 4) ? GREEN : ((i < 8) ? YELLOW : RED);
        }
        canvas.fillRect(segX, segY, segW, segH, bColor);
    }

    canvas.setTextColor(WHITE);
    canvas.setTextSize(2);
    canvas.drawString("AMMO:", 15, 175);

    for (int i = 0; i < 5; i++) {
        int x = 12 + i * 23;
        int y = 200;
        if (i < ammo) {
            canvas.fillRoundRect(x, y, 16, 26, 4, CYAN);
            canvas.fillTriangle(x, y, x + 16, y, x + 8, y - 6, YELLOW);
        } else {
            canvas.drawRoundRect(x, y, 16, 26, 4, canvas.color565(80, 80, 80));
        }
    }
}

void scheduleNextTaunt() {
    nextTauntTime = millis() + random(40000, 75000);
}

void resetGameState() {
    currentGameId = 0;
    peerConnectedOnce = false;
    isDodging = false;
    isHunterWaiting = false;
    isListeningForIR = false;
    zeroAmmoTime = 0;
    ammo = 5;
    lastRssi = -100;
    flagFoxHit = false;
    flagDodgeTriggered = false;
    flagHunterWait = false;
    flagVictory = false;
    nextTauntTime = 0;
}

void setup() {
    Serial.begin(115200);
    delay(500);

    auto cfg = M5.config();
    M5.begin(cfg);

    M5.Power.setExtOutput(true);
    M5.Display.setBrightness(180);

    pinMode(BTN_BLUE_PIN, INPUT_PULLUP);
    pinMode(BTN_SIDE_PIN, INPUT_PULLUP);

    M5.Display.setRotation(0);
    canvas.setPsram(false); 
    canvas.createSprite(135, 240); 

    WiFi.mode(WIFI_STA);
    WiFi.disconnect();
    esp_wifi_set_max_tx_power(MAX_TX_POWER); 

    if (esp_now_init() == ESP_OK) {
        esp_now_peer_info_t peerInfo = {};
        memcpy(peerInfo.peer_addr, broadcastMac, 6);
        peerInfo.channel = 1;
        peerInfo.encrypt = false;
        esp_now_add_peer(&peerInfo);
        esp_now_register_recv_cb(esp_now_recv_cb_t(onDataRecv));
    }

    currentRole = ROLE_SELECT;
}

void loop() {
    M5.update();
    unsigned long now = millis();

    // Battery protection
    int currentBat = M5.Power.getBatteryLevel();
    if (currentBat >= 0 && currentBat <= 8) {
        M5.Display.startWrite();
        M5.Display.fillScreen(RED);
        M5.Display.setTextColor(WHITE);
        M5.Display.setTextSize(2);
        M5.Display.drawCenterString("BATTERY EMPTY", 67, 100);
        M5.Display.drawCenterString("POWER OFF...", 67, 140);
        M5.Display.endWrite();
        M5.Power.powerOff(); 
    }

    // Process IR reception via RMT hardware
    if (currentRole == ROLE_FOX && !isDodging) {
        if (rx_done) {
            rx_done = false;
            uint32_t rx_raw = 0;
            if (decodeNEC(rx_raw_symbols, &rx_raw)) {
                uint16_t rx_addr = rx_raw & 0xFFFF;
                uint8_t  rx_cmd  = (rx_raw >> 16) & 0xFF;
                if (rx_addr == NEC_SHOT_ADDR && rx_cmd == NEC_SHOT_CMD) {
                    isListeningForIR = false;
                    flagFoxHit = true;
                }
            }
            start_rmt_receive();
        }

        // Check if 500ms reaction window expired without IR hit
        if (isListeningForIR && now > listenIREndTime) {
            isListeningForIR = false;
            flagDodgeTriggered = true;
        }
    }

    // Button Edge Detection
    bool curBlue = digitalRead(BTN_BLUE_PIN);
    bool curSide = digitalRead(BTN_SIDE_PIN);

    bool bluePressed = (curBlue == LOW && lastBlueState == HIGH);
    bool sidePressed = (curSide == LOW && lastSideState == HIGH);
    bool bothPressed = (curBlue == LOW && curSide == LOW);

    lastBlueState = curBlue;
    lastSideState = curSide;

    if (currentRole != ROLE_SELECT && bothPressed) {
        currentRole = ROLE_SELECT;
        resetGameState();
        M5.Speaker.begin();
        M5.Speaker.tone(1000, 70);
        delay(100);
        M5.Speaker.stop();
        M5.Speaker.end();
    }

    // Game Event Handling
    if (flagFoxHit) {
        flagFoxHit = false;
        sendGamePacket(2); 
        currentRole = ROLE_GAME_OVER;
        M5.Speaker.begin();
        M5.Speaker.tone(300, 400); 
        delay(400);
        M5.Speaker.stop();
        M5.Speaker.end();
    }
    
    if (flagDodgeTriggered) {
        flagDodgeTriggered = false;
        isDodging = true;
        dodgeEndTime = now + DODGE_DURATION_MS; 
        sendGamePacket(3); 
        playDodgeSiren();
    }

    if (flagHunterWait) {
        flagHunterWait = false;
        isHunterWaiting = true;
        hunterWaitEndTime = now + DODGE_DURATION_MS; 
        M5.Speaker.tone(400, 300);
        delay(300);
        M5.Speaker.stop();
    }
    
    if (flagVictory) {
        flagVictory = false;
        currentRole = ROLE_VICTORY;
        playVictoryFanfare();
    }

    // Keepalive ping
    static unsigned long lastPingSent = 0;
    if (now - lastPingSent > LINK_CHECK_INTERVAL_MS) {
        lastPingSent = now;
        if (currentRole == ROLE_FOX || currentRole == ROLE_HUNTER) {
            sendGamePacket(0);
        }
        isLinkAlive = (now - lastPeerSeen < 3000);

        if (peerConnectedOnce && (now - lastPeerSeen > LINK_TIMEOUT_MS) && 
            (currentRole == ROLE_FOX || currentRole == ROLE_HUNTER)) {
            currentRole = ROLE_VICTORY;
            M5.Speaker.tone(200, 500);
            delay(500);
            M5.Speaker.stop();
        }
    }

    // Role State Machine
    if (currentRole == ROLE_SELECT) {
        if (sidePressed) { // Select Fox
            currentRole = ROLE_FOX;
            resetGameState();
            scheduleNextTaunt();

            M5.Speaker.end();
            setup_rmt_rx();
            start_rmt_receive();
        }
        if (bluePressed) { // Select Hunter
            currentRole = ROLE_HUNTER;
            resetGameState();
            currentGameId = ((uint32_t)esp_random() % 900000) + 100000;
            setup_rmt_tx();
            M5.Speaker.begin();
            M5.Speaker.setVolume(50);
            M5.Speaker.tone(2000, 80);
            delay(80);
            M5.Speaker.stop();
        }
    } 
    else if (currentRole == ROLE_FOX) {
        if (isDodging) {
            if (now > dodgeEndTime) {
                isDodging = false;
                scheduleNextTaunt();
            }
        } else {
            if (sidePressed || now >= nextTauntTime) { 
                playBark();
                scheduleNextTaunt();
            }
            if (isBarkingAnim && now > barkAnimEndTime) {
                isBarkingAnim = false;
            }
        }
    } 
    else if (currentRole == ROLE_HUNTER) {
        if (isHunterWaiting) {
            if (now > hunterWaitEndTime) {
                isHunterWaiting = false;
                M5.Speaker.tone(1500, 120);
                delay(120);
                M5.Speaker.stop();
            }
        } else {
            if (bluePressed) { 
                if (ammo > 0) {
                    ammo--;
                    playShotSound();       
                    sendGamePacket(1);
                    fireInfraredShot();
                    if (ammo == 0) zeroAmmoTime = now;
                } else {
                    M5.Speaker.tone(250, 40);
                    delay(40);
                    M5.Speaker.stop();
                }
            }
        }

        if (currentRole == ROLE_HUNTER && ammo == 0 && zeroAmmoTime != 0 && (now - zeroAmmoTime > 2000)) {
            sendGamePacket(4); 
            currentRole = ROLE_GAME_OVER;
            zeroAmmoTime = 0;
            M5.Speaker.tone(200, 1000);
            delay(1000);
            M5.Speaker.stop();
        }
    }

    // Refresh display (20 FPS)
    static unsigned long lastFrameTime = 0;
    if (now - lastFrameTime >= 50) { 
        lastFrameTime = now;

        if (currentRole == ROLE_SELECT) {
            canvas.fillScreen(canvas.color565(20, 20, 45));
            canvas.setTextColor(YELLOW);
            canvas.setTextSize(2);
            canvas.drawCenterString("FOX HUNT", 67, 25);

            canvas.fillRoundRect(10, 65, 115, 60, 8, ORANGE);
            canvas.setTextColor(BLACK);
            canvas.drawCenterString("SIDE BTN", 67, 75);
            canvas.drawCenterString("FOX", 67, 100);

            canvas.fillRoundRect(10, 145, 115, 60, 8, CYAN);
            canvas.setTextColor(BLACK);
            canvas.drawCenterString("BLUE BTN", 67, 155);
            canvas.drawCenterString("HUNTER", 67, 180);

            drawBattery();
        } 
        else if (currentRole == ROLE_FOX) {
            if (isDodging) {
                drawFoxDodgeUI((dodgeEndTime - now) / 1000);
            } else {
                drawFoxFace(isBarkingAnim);
            }
        } 
        else if (currentRole == ROLE_HUNTER) {
            if (isHunterWaiting) {
                drawHunterWaitUI((hunterWaitEndTime - now) / 1000);
            } else {
                drawHunterUI();
            }
        } 
        else if (currentRole == ROLE_VICTORY) {
            canvas.fillScreen(canvas.color565(0, 160, 0));
            canvas.setTextColor(YELLOW);
            canvas.setTextSize(2);
            canvas.drawCenterString("VICTORY!", 67, 40);
            canvas.setTextColor(WHITE);
            canvas.drawCenterString(currentRole == ROLE_FOX ? "SURVIVED!" : "FOX CAUGHT", 67, 90);
            canvas.setTextSize(1);
            canvas.drawCenterString("BOTH BTNS TO MENU", 67, 180);
            drawBattery();
        } 
        else if (currentRole == ROLE_GAME_OVER) {
            canvas.fillScreen(BLACK);
            canvas.setTextColor(RED);
            canvas.setTextSize(2);
            canvas.drawCenterString("GAME OVER!", 67, 40);
            canvas.setTextSize(4);
            canvas.drawCenterString("X_X", 67, 90);
            canvas.setTextSize(1);
            canvas.setTextColor(WHITE);
            canvas.drawCenterString("BOTH BTNS TO MENU", 67, 180);
            drawBattery();
        }

        M5.Display.startWrite();
        canvas.pushSprite(0, 0);
        M5.Display.endWrite();
    }
}
