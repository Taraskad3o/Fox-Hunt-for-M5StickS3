// --- NATIVE ESP-IDF RMT DRIVERS ---
#include "driver/rmt_tx.h"
#include "driver/rmt_rx.h"
#include "driver/rmt_encoder.h"

// --- HARDWARE PIN DEFINITIONS (M5StickS3) ---
#define IR_TX_PIN       46 
#define IR_RX_PIN       42 
#define BTN_BLUE_PIN    11 
#define BTN_SIDE_PIN    12 

// --- GAME CONFIGURATION ---
const int RSSI_DANGER_THRESHOLD = -68;
const int DODGE_DURATION_MS = 30000;
const int IR_LISTEN_WINDOW_MS = 500;
const int MAX_TX_POWER = 52; 
const int LINK_CHECK_INTERVAL_MS = 500;
const int LINK_TIMEOUT_MS = 25000;

// NEC Protocol Constants
const uint16_t NEC_SHOT_ADDR = 0x1234;
const uint8_t  NEC_SHOT_CMD  = 0x77;

#define NEC_HEADER_MARK     9000
#define NEC_HEADER_SPACE    4500
#define NEC_BIT_MARK        560
#define NEC_BIT_0_SPACE     560
#define NEC_BIT_1_SPACE     1690

// --- ESP-NOW PACKET ---
typedef struct __attribute__((packed)) {
    uint32_t gameId;
    uint8_t role;      // 1 - Fox, 2 - Hunter
    uint8_t event;     // 0 - Ping, 1 - Shot, 2 - Hit, 3 - Dodge, 4 - Out of Ammo
    int8_t rssi;
} GamePacket;

uint8_t broadcastMac[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

enum GameRole { ROLE_SELECT, ROLE_FOX, ROLE_HUNTER, ROLE_VICTORY, ROLE_GAME_OVER };
GameRole currentRole = ROLE_SELECT;

M5Canvas canvas(&M5.Display);

// --- RMT HANDLES & BUFFERS ---
rmt_channel_handle_t tx_chan = NULL;
rmt_encoder_handle_t copy_encoder = NULL;

rmt_channel_handle_t rx_chan = NULL;
static rmt_symbol_word_t rx_raw_symbols[128];
static volatile bool rx_done = false;

// --- STATE VARIABLES ---
uint32_t currentGameId = 0;
unsigned long lastPeerSeen = 0;
bool isLinkAlive = false;
bool peerConnectedOnce = false;
int lastRssi = -100;

int ammo = 5;
bool isHunterWaiting = false;
unsigned long hunterWaitEndTime = 0;
unsigned long zeroAmmoTime = 0;

unsigned long nextTauntTime = 0;
bool isBarkingAnim = false;
unsigned long barkAnimEndTime = 0;
bool isDodging = false;
unsigned long dodgeEndTime = 0;

// Window to listen for IR after shot packet
bool isListeningForIR = false;
unsigned long listenIREndTime = 0;

volatile bool flagFoxHit = false;
volatile bool flagDodgeTriggered = false;
volatile bool flagHunterWait = false;
volatile bool flagVictory = false;

bool lastBlueState = HIGH;
bool lastSideState = HIGH;

// --- RMT NEC IMPLEMENTATION ---
uint32_t buildNECRaw(uint16_t address, uint8_t command) {
    uint16_t nec_addr;
    if (address <= 0x00FF) {
        uint8_t addr8 = address & 0xFF;
        nec_addr = ((uint16_t)(~addr8) << 8) | addr8;
    } else {
        nec_addr = address;
    }
    uint32_t raw = 0;
    raw |= (uint32_t)nec_addr;
    raw |= (uint32_t)command << 16;
    raw |= (uint32_t)(~command) << 24;
    return raw;
}

void encodeNEC(uint32_t raw_data, rmt_symbol_word_t *symbols, size_t *symbol_count) {
    size_t idx = 0;
    symbols[idx].duration0 = NEC_HEADER_MARK;
    symbols[idx].level0 = 1;
    symbols[idx].duration1 = NEC_HEADER_SPACE;
    symbols[idx].level1 = 0;
    idx++;

    for (int i = 0; i < 32; i++) {
        symbols[idx].duration0 = NEC_BIT_MARK;
        symbols[idx].level0 = 1;
        if (raw_data & (1UL << i)) {
            symbols[idx].duration1 = NEC_BIT_1_SPACE;
        } else {
            symbols[idx].duration1 = NEC_BIT_0_SPACE;
        }
        symbols[idx].level1 = 0;
        idx++;
    }

    symbols[idx].duration0 = NEC_BIT_MARK;
    symbols[idx].level0 = 1;
    symbols[idx].duration1 = 0;
    symbols[idx].level1 = 0;
    idx++;

    *symbol_count = idx;
}

void setup_rmt_tx() {
    if (tx_chan != NULL) return;
    rmt_tx_channel_config_t tx_chan_config = {
        .gpio_num = (gpio_num_t)IR_TX_PIN,
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .resolution_hz = 1000000,
        .mem_block_symbols = 64,
        .trans_queue_depth = 4,
        .flags = {
            .invert_out = false,
            .with_dma = false,
        }
    };
    ESP_ERROR_CHECK(rmt_new_tx_channel(&tx_chan_config, &tx_chan));

    rmt_carrier_config_t carrier_cfg = {
        .frequency_hz = 38000,
        .duty_cycle = 0.50,
        .flags = {
            .polarity_active_low = false,
        }
    };
    ESP_ERROR_CHECK(rmt_apply_carrier(tx_chan, &carrier_cfg));

    rmt_copy_encoder_config_t encoder_config = {};
    ESP_ERROR_CHECK(rmt_new_copy_encoder(&encoder_config, &copy_encoder));
    ESP_ERROR_CHECK(rmt_enable(tx_chan));
}

void fireInfraredShot() {
    if (tx_chan == NULL) setup_rmt_tx();
    uint32_t raw = buildNECRaw(NEC_SHOT_ADDR, NEC_SHOT_CMD);
    rmt_symbol_word_t symbols[68];
    size_t symbol_count = 0;
    encodeNEC(raw, symbols, &symbol_count);

    rmt_transmit_config_t tx_config = {
        .loop_count = 0,
        .flags = { .eot_level = 0 }
    };
    
    rmt_transmit(tx_chan, copy_encoder, symbols, symbol_count * sizeof(rmt_symbol_word_t), &tx_config);
    rmt_tx_wait_all_done(tx_chan, 150);
}

static bool rmt_rx_done_callback(rmt_channel_handle_t channel, const rmt_rx_done_event_data_t *edata, void *user_data) {
    rx_done = true;
    return true;
}

void setup_rmt_rx() {
    if (rx_chan != NULL) return;
    rmt_rx_channel_config_t rx_chan_config = {
        .gpio_num = (gpio_num_t)IR_RX_PIN,
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .resolution_hz = 1000000,
        .mem_block_symbols = 128,
    };
    ESP_ERROR_CHECK(rmt_new_rx_channel(&rx_chan_config, &rx_chan));

    rmt_rx_event_callbacks_t cbs = {
        .on_recv_done = rmt_rx_done_callback,
    };
    ESP_ERROR_CHECK(rmt_rx_register_event_callbacks(rx_chan, &cbs, NULL));
    ESP_ERROR_CHECK(rmt_enable(rx_chan));
}

void start_rmt_receive() {
    if (rx_chan == NULL) return;
    rmt_receive_config_t receive_config = {
        .signal_range_min_ns = 1250,
        .signal_range_max_ns = 12000000
    };
    rmt_receive(rx_chan, rx_raw_symbols, sizeof(rx_raw_symbols), &receive_config);
}

bool decodeNEC(rmt_symbol_word_t *symbols, uint32_t *out_raw) {
    *out_raw = 0;
    uint32_t header_low  = symbols[0].duration0;
    uint32_t header_high = symbols[0].duration1;

    if (header_low < 6500 || header_low > 11500 || header_high < 2500 || header_high > 6000) {
        return false;
    }

    for (int i = 0; i < 32; i++) {
        uint32_t mark  = symbols[i + 1].duration0;
        uint32_t space = symbols[i + 1].duration1;

        if (mark < 200 || mark > 1100) return false;
        
        if (space > 950) {
            *out_raw |= (1UL << i);
        }
    }

    uint8_t cmd     = (*out_raw >> 16) & 0xFF;
    uint8_t cmd_inv = (*out_raw >> 24) & 0xFF;
    return ((cmd ^ cmd_inv) == 0xFF);
}

// --- COMMS ---
void sendGamePacket(uint8_t eventType) {
    if (currentGameId == 0) return;
    GamePacket pkt;
    pkt.gameId = currentGameId;
    pkt.role = (currentRole == ROLE_FOX) ? 1 : 2;
    pkt.event = eventType;
    pkt.rssi = (int8_t)lastRssi;
    esp_now_send(broadcastMac, (uint8_t *)&pkt, sizeof(pkt));
}

void onDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len) {
    if (len != sizeof(GamePacket)) return;
    GamePacket *pkt = (GamePacket *)incomingData;

    if (info->rx_ctrl != nullptr) {
        lastRssi = info->rx_ctrl->rssi;
    }

    if (currentRole == ROLE_FOX && currentGameId == 0 && pkt->role == 2) {
        currentGameId = pkt->gameId;
    }

    if (pkt->gameId == currentGameId) {
        lastPeerSeen = millis();
        isLinkAlive = true;
        peerConnectedOnce = true;

        // Shot packet received by Fox
        if (currentRole == ROLE_FOX && pkt->event == 1 && !isDodging) {
            if (lastRssi > RSSI_DANGER_THRESHOLD) {
                isListeningForIR = true;
                listenIREndTime = millis() + IR_LISTEN_WINDOW_MS;
            }
        }

        // Hit confirmed
        if (currentRole == ROLE_HUNTER && pkt->event == 2) {
            flagVictory = true;
        }

        // Dodge confirmed -> Hunter wait penalty
        if (currentRole == ROLE_HUNTER && pkt->event == 3) {
            flagHunterWait = true;
        }

        // Hunter out of ammo
        if (currentRole == ROLE_FOX && pkt->event == 4) {
            flagVictory = true;
        }
    } else if (peerConnectedOnce && pkt->gameId != currentGameId && pkt->gameId != 0) {
        flagVictory = true;
    }
}

// --- AUDIO ---
void playBark() {
    M5.Speaker.begin();
    M5.Speaker.setVolume(50);
    M5.Speaker.tone(1900, 50);
    delay(70); 
    M5.Speaker.tone(2500, 70);
    M5.Speaker.stop();
    M5.Speaker.end();
}

void playShotSound() {
    for (int f = 3000; f > 600; f -= 300) {
        M5.Speaker.tone(f, 5);
        delay(6); 
    }
    M5.Speaker.stop();
}

void playVictoryFanfare() {
    int notes[] = {1200, 1500, 1800, 2200};
    for (int n : notes) {
        M5.Speaker.tone(n, 80);
        delay(90); 
    }
    M5.Speaker.stop();
}

void playDodgeSiren() {
    M5.Speaker.begin();
    M5.Speaker.setVolume(50);
    for (int i = 0; i < 2; i++) {
        M5.Speaker.tone(800, 80);
        delay(60);
        M5.Speaker.tone(1300, 90);
        delay(70);
    }
    M5.Speaker.stop();
    M5.Speaker.end();
}

// --- UI RENDERING ---
void drawBattery() {
    int b = M5.Power.getBatteryLevel();
    if (b < 0) b = 0; 
    if (b > 100) b = 100;

    uint16_t batColor = GREEN;
    if (b <= 10) batColor = RED;
    else if (b <= 25) batColor = YELLOW;

    bool showText = !(b <= 10 && ((millis() / 500) % 2 == 0));
    canvas.setTextSize(1);
    canvas.setTextColor(batColor);

    int bx = 110, by = 5, bw = 18, bh = 10;
    if (showText) {
        char buf[8];
        if (b <= 10) sprintf(buf, "LOW");
        else sprintf(buf, "%d%%", b);
        canvas.drawRightString(buf, bx - 4, by + 1);
    }

    canvas.drawRect(bx, by, bw, bh, batColor);
    canvas.fillRect(bx + bw, by + 2, 2, bh - 4, batColor);

    int bars = (b > 75) ? 3 : ((b > 40) ? 2 : ((b > 10) ? 1 : 0));
    for (int i = 0; i < bars; i++) {
        canvas.fillRect(bx + 2 + (i * 5), by + 2, 4, bh - 4, batColor);
    }
}

